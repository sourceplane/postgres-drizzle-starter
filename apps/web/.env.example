# Local development without wrangler (`next dev` with no wrangler.jsonc):
# a Postgres connection string. With wrangler (the default), the HYPERDRIVE
# binding's localConnectionString in wrangler.jsonc is used instead.
POSTGRES_URL=postgres://postgres:postgres@localhost:54322/postgres
# Optional: the site's public origin for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
