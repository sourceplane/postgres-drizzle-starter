// Rendered to wrangler.jsonc (git-ignored) by tooling/wire: the verify lane
// renders from wiring.fixture.json, the deploy lane from the wiring document
// the `cloudflare-hyperdrive` Terraform root lease-publishes
// (WIRING_CLOUDFLARE_HYPERDRIVE_<ENV>). The workers-assets composition deploys
// one environment per job with no wrangler `--env`, so `__ENV__` names the
// environment this is rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postgres-drizzle-starter-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Supabase Postgres through Hyperdrive (pooled, cached). Locally, wrangler
  // connects straight to the Supabase CLI's database.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "@@wiring(cloudflare-hyperdrive/__ENV__:hyperdrive_id)@@",
      "localConnectionString": "postgres://postgres:postgres@localhost:54322/postgres"
    }
  ]
}
